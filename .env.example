# VOX Studio — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/vox_studio

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Temporal ────────────────────────────────────────────────────────────────
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=vox-studio

# ─── Auth / JWT ──────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d

# ─── Object Storage (S3-compatible) ─────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vox-studio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ─── AI Providers (server-side only — never expose to browser) ───────────────
VOX_RUNTIME_MODE=mock

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MUSE_MODEL=meta/muse-glimmer-30b
NVIDIA_TIMEOUT_MS=60000
NVIDIA_MAX_RETRIES=2

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
STABILITY_API_KEY=
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=
SUNO_API_KEY=

# ─── Observability ───────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=vox-studio
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ─── Feature Flags ───────────────────────────────────────────────────────────
ENABLE_MOCK_PROVIDERS=true
ENABLE_COST_TRACKING=true
